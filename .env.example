# Aholo API Configuration
# Get your API key from https://labs.aholo3d.com/api-keys (or https://labs.aholo3d.cn/api-keys)
AHOLO_API_KEY=your_aholo_api_key_here

# Aholo API Base URL
# Default international: https://api.aholo3d.com (or https://api.aholo.ai)
# China region: https://api.aholo3d.cn
AHOLO_API_BASE=https://api.aholo3d.com
